/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "navihive",
    "main": "worker/index.ts",
    "compatibility_date": "2025-04-05",
    "assets": {
        "not_found_handling": "single-page-application"
    },
    "observability": {
        "enabled": true
    },
    // D1数据库绑定
    "d1_databases": [
        {
            "binding": "DB",
            "database_name": "navihive-db",
            "database_id": "f5c9a592-c36d-4ea3-8218-497a8a173db9"
        }
    ],
    "vars": {
        "AUTH_ENABLED": "true",
        "AUTH_REQUIRED_FOR_READ": "false",
        "AUTH_USERNAME": "admin",
        "AUTH_PASSWORD": "$2a$10$ItQvxHOXIr6Rvle5CKLgRuDQZxd4VieWtzk2fdlJhywnDa.RhVptS",
        "AUTH_SECRET": "d5903e08e421428d0e277e41475353c985b9d0cd3cc8c63165c8eb7e69acf778"
    }
}
